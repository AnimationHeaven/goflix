# Optional: reuse a Gofile account token (from gofile.io profile) instead of creating a guest.
# Useful when guest creation is rate-limited.
# GOFILE_TOKEN=

# Override website-token salt if Gofile rotates it.
# Current known value (2026): 9844d94d963d30
# GOFILE_WT_SALT=9844d94d963d30

# API port (default 3001)
# PORT=3001
