<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle diagonal gradient instead of flat black — same near-black family
     as the rest of the app, but with just enough depth to read as designed
     rather than a placeholder fill. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#121214"
                android:endColor="#1D0509" />
        </aapt:attr>
    </path>
</vector>
